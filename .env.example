# Copy to .env and fill in your OpenRouter key.
# Primary agent: Qwen3-8B. Fallback: moonshotai/kimi-k3.
# Do not point this at GPT-6 Astra or Opus.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CURSOR_OPENAI_BASE_URL=https://openrouter.ai/api/v1/cursor
OPENAI_MODEL=qwen/qwen3-8b
AHA3D_AGENT_MODEL=qwen/qwen3-8b
AHA3D_AGENT_FALLBACK_MODEL=moonshotai/kimi-k3
AHA3D_AGENT_PROVIDER=openrouter
# Cursor Settings → Models: OpenAI API Key = OPENROUTER_API_KEY,
# Override Base URL = CURSOR_OPENAI_BASE_URL, Add model = AHA3D_AGENT_MODEL.
